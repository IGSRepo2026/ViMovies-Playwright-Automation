{
  "name": "vimovies-automation",
  "version": "1.0.0",
  "private": true,
  "description": "ViMovies OTT Platform - Playwright Automation Framework",
  "engines": {
    "yarn": "Use NPM instead",
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:regression": "playwright test --grep \"@regression\"",
    "test:search": "playwright test --grep \"@search\"",
    "test:login": "playwright test --grep \"@login\"",
    "lint": "eslint -c ./eslint.config.mjs .",
    "lint:fix": "eslint -c ./eslint.config.mjs --fix --quiet ./src",
    "lint:pre-commit": "eslint -c ./eslint.config.pre-commit.mjs --fix --quiet",
    "pretty:pre-commit": "prettier --write",
    "ts:check": "tsc --noEmit",
    "update": "ncu --interactive",
    "prepare": "husky",
    "allure:generate": "allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report:clean": "rimraf allure-results allure-report"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.11.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-check-updates": "^19.6.6",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "lint-staged": {
    "*.ts": [
      "npm run lint:pre-commit",
      "npm run pretty:pre-commit"
    ]
  }
}
